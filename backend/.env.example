DATABASE_URL_FILE=/run/secrets/database_url
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD_HASH_FILE=/run/secrets/operator_argon2id
ONOMONDO_API_KEY_FILE=/run/secrets/onomondo_api_key
ONOMONDO_API_URL=https://app.esim-iot.onomondo.com/api
ONOMONDO_SCHEMA_CONFIRMED=false
POLL_INTERVAL=15
MQTT_HOST=mqtt.example.invalid
MQTT_PORT=8883
MQTT_CA=/etc/sgp32/ca.crt
MQTT_USERNAME=backend
MQTT_PASSWORD_FILE=/run/secrets/backend_mqtt_password
