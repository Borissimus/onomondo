AGENT_DEVICE_ID=device-a
AGENT_SERIAL_PORT=/dev/ttyUSB2
AGENT_BAUD=115200
AGENT_COMMAND_DB=/var/lib/sgp32-agent/commands.db
AGENT_SIMULATE=false
AGENT_ALLOW_IMSI=false
MQTT_HOST=mqtt.example.invalid
MQTT_PORT=8883
MQTT_CA=/etc/sgp32-agent/ca.crt
MQTT_USERNAME=device-a
MQTT_PASSWORD_FILE=/run/secrets/device_mqtt_password
